{
  "schema": 1,
  "id": "gate-pine-compat-public",
  "version": "1",
  "rules": [
    {
      "id": "ts-strip-bom-v1",
      "version": 1,
      "stage": "typescript-post",
      "enabled": true,
      "description": "清理生成 TypeScript 开头残留的 UTF-8 BOM。",
      "match": {
        "regex": "^\\uFEFF"
      },
      "transform": {
        "type": "regex-replace",
        "pattern": "^\\uFEFF",
        "replacement": ""
      }
    }
  ]
}
